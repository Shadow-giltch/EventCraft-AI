            "title": "Tokens Used",
            "description": "Reported token count."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source",
          "cache",
          "latency_ms"
        ],
        "title": "GenerationMetadata",
        "description": "Execution metadata detailing source, caching, and latency."
      },
      "HTTPValidationError": {
        "properties": {
