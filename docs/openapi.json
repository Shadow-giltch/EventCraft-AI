  "components": {
    "schemas": {
      "AssistantAnswerResponse": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "latency_ms": {
            "type": "integer",
            "title": "Latency Ms"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "answer",
          "source",
          "latency_ms"
        ],
        "title": "AssistantAnswerResponse",
        "description": "Response returned by the grounded event planning assistant."
      },
      "AssistantAskRequest": {
        "properties": {
          "brief": {
            "$ref": "#/components/schemas/EventBriefRequest"
          },
          "question": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Question"
          },
          "chat_history": {
            "items": {
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "string"
                }
              ],
              "type": "array",
              "maxItems": 2,
              "minItems": 2
            },
            "type": "array",
            "maxItems": 6,
            "title": "Chat History"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "brief",
          "question"
        ],
        "title": "AssistantAskRequest",
        "description": "Request payload for grounded event planning assistant conversation."
      },
      "BudgetLineResponse": {
        "properties": {
          "category": {
            "type": "string",
            "title": "Category"
          },
          "percent": {
            "type": "string",
            "title": "Percent"
          },
          "amount": {
            "type": "string",
            "title": "Amount"
          },
          "rationale": {
            "type": "string",
            "title": "Rationale"
          },
          "saving_tip": {
            "type": "string",
            "title": "Saving Tip"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "category",
          "percent",
          "amount",
          "rationale",
          "saving_tip"
        ],
        "title": "BudgetLineResponse",
        "description": "Single budget line allocation."
      },
      "BudgetRebalanceRequest": {
        "properties": {
          "event_type": {
            "type": "string",
            "enum": [
              "wedding",
              "birthday",
              "community"
            ],
            "title": "Event Type"
          },
          "budget_total": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100000000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Budget Total"
          },
          "currency": {
            "type": "string",
            "enum": [
              "INR",
              "USD",
              "EUR",
              "GBP"
            ],
            "title": "Currency",
            "default": "INR"
          },
          "guest_count": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Guest Count"
          },
          "priorities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Priorities"
          },
          "custom_weights": {
            "anyOf": [
              {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Custom Weights"
          },
          "contingency_percent": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 15.0,
                "minimum": 3.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Contingency Percent",
            "default": "5.00"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_type",
          "budget_total",
          "guest_count"
        ],
        "title": "BudgetRebalanceRequest",
        "description": "Request payload to recalculate budget with zero LLM invocations."
      },
      "BudgetResponse": {
        "properties": {
          "total_amount": {
            "type": "string",
            "title": "Total Amount"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "guest_count": {
            "type": "integer",
            "title": "Guest Count"
          },
          "cost_per_guest": {
            "type": "string",
            "title": "Cost Per Guest"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/BudgetLineResponse"
            },
            "type": "array",
            "title": "Lines"
          },
          "contingency_amount": {
            "type": "string",
            "title": "Contingency Amount"
          },
          "meta": {
            "$ref": "#/components/schemas/GenerationMetadata"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "total_amount",
          "currency",
          "guest_count",
          "cost_per_guest",
          "lines",
          "contingency_amount",
          "meta"
        ],
        "title": "BudgetResponse",
        "description": "Budget deliverable response model."
      },
      "EventBriefRequest": {
        "properties": {
          "event_type": {
            "type": "string",
            "enum": [
              "wedding",
              "birthday",
              "community"
            ],
            "title": "Event Type",
            "description": "Category of event to organize."
          },
          "event_date": {
            "type": "string",
            "format": "date",
            "title": "Event Date",
            "description": "Target date for the celebration."
          },
          "guest_count": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Guest Count",
            "description": "Expected head count."
          },
          "budget_total": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100000000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Budget Total",
            "description": "Total planned financial budget."
          },
          "currency": {
            "type": "string",
            "enum": [
              "INR",
              "USD",
              "EUR",
              "GBP"
            ],
            "title": "Currency",
            "description": "Three-letter currency code.",
            "default": "INR"
          },
          "culture_or_tradition": {
            "type": "string",
            "maxLength": 100,
            "title": "Culture Or Tradition",
            "default": ""
          },
          "style": {
            "type": "string",
            "maxLength": 100,
            "title": "Style",
            "default": ""
          },
          "priorities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Priorities"
          },
          "dietary_needs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Dietary Needs"
          },
          "accessibility_needs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Accessibility Needs"
          },
          "interests": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Interests"
          },
          "steer": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "title": "Steer"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_type",
          "event_date",
          "guest_count",
          "budget_total"
        ],
        "title": "EventBriefRequest",
        "description": "Core user inputs specifying requirements for event organization."
      },
      "FullPlanResponse": {
        "properties": {
          "budget": {
            "$ref": "#/components/schemas/BudgetResponse"
          },
          "timeline": {
            "$ref": "#/components/schemas/TimelineResponse"
          },
          "vendor_checklist": {
            "$ref": "#/components/schemas/VendorChecklistResponse"
          },
          "personalized_ideas": {
            "$ref": "#/components/schemas/PersonalizedIdeasResponse"
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer",
            "default": "All figures and dates are planning estimates, not guaranteed commercial quotes."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "budget",
          "timeline",
          "vendor_checklist",
          "personalized_ideas"
        ],
        "title": "FullPlanResponse",
        "description": "Complete multi-deliverable plan generated for the user event brief."
      },
      "GenerationMetadata": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source",
            "description": "Generator source: 'ai' or 'template'."
          },
          "cache": {
            "type": "string",
            "title": "Cache",
            "description": "Cache outcome: 'hit' or 'miss'."
          },
          "latency_ms": {
            "type": "integer",
            "title": "Latency Ms",
            "description": "Generation latency in milliseconds."
          },
          "tokens_used": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
